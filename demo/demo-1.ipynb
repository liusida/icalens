},{&quot;text&quot;:&quot; with&quot;,&quot;logit&quot;:-4.03125},{&quot;text&quot;:&quot; a&quot;,&quot;logit&quot;:-4.09375}]},&quot;767&quot;:{&quot;dominant_sign&quot;:&quot;negative&quot;,&quot;sign_statistics&quot;:{&quot;negative_energy_fraction&quot;:0.5115078836674102,&quot;negative_fraction&quot;:0.51264,&quot;positive_energy_fraction&quot;:0.4884921163325907,&quot;positive_fraction&quot;:0.48736},&quot;occurrences&quot;:[],&quot;logit_tokens&quot;:[{&quot;text&quot;:&quot;,&quot;,&quot;logit&quot;:-5.1875},{&quot;text&quot;:&quot; in&quot;,&quot;logit&quot;:-5.5},{&quot;text&quot;:&quot; and&quot;,&quot;logit&quot;:-5.625},{&quot;text&quot;:&quot;\\n&quot;,&quot;logit&quot;:-5.6875},{&quot;text&quot;:&quot; the&quot;,&quot;logit&quot;:-5.9375},{&quot;text&quot;:&quot; a&quot;,&quot;logit&quot;:-5.96875},{&quot;text&quot;:&quot; of&quot;,&quot;logit&quot;:-6.0},{&quot;text&quot;:&quot; to&quot;,&quot;logit&quot;:-6.0},{&quot;text&quot;:&quot; (&quot;,&quot;logit&quot;:-6.125},{&quot;text&quot;:&quot;.&quot;,&quot;logit&quot;:-6.1875}]}}};\n",
       "    const esc = value =&gt; String(value).replace(/[&amp;&lt;&gt;&quot;&#x27;]/g, char =&gt; ({\n",
